# RootCause on-site configuration. Copy to .env for a local run.
# The public demo needs none of these.

# Where the SQLite case store and temp uploads live
ROOTCAUSE_RUNTIME=./runtime
# ROOTCAUSE_DB=./runtime/rootcause.sqlite3

# Offline demo pack (generated by scripts/build_demo_pack.py)
# ROOTCAUSE_PACK=./server/rootcause/data/demo_pack.json

# Comma-separated browser origins allowed to call the API
ROOTCAUSE_CORS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Optional Ascend NPU broker. Leave empty to use the CPU detector.
# ROOTCAUSE_NPU=ascend
# ROOTCAUSE_NPU_ENDPOINT=http://127.0.0.1:7788
# ROOTCAUSE_NPU_MODEL=defect.om

# Optional tenant list (each is a separate SQLite file, selected by X-RootCause-Tenant)
# ROOTCAUSE_TENANTS=werk-sued,werk-east

# Optional in-process proactive scheduler (a systemd timer or orchestrator can call /api/proactive/scan instead)
# ROOTCAUSE_SCHEDULER=1

# ---------------------------------------------------------------------------
# Production wiring
# ---------------------------------------------------------------------------
# Agent runtime: JiuwenSwarm / openJiuwen ReAct. Without all four model values the
# /api/agent endpoints return 503; there is no fake fallback.
# ROOTCAUSE_AGENT_BACKEND=openjiuwen
# MODEL_PROVIDER=OpenAI
# API_BASE=https://your-llm-endpoint/v1
# API_KEY=replace-me
# MODEL_NAME=replace-me
# LLM_SSL_VERIFY=true
# ROOTCAUSE_AGENT_MAX_ITERATIONS=8

# Inference backend: onnx | ascend | local. Production must use onnx or ascend.
# ROOTCAUSE_NPU_BACKEND=onnx
# ROOTCAUSE_NPU_MODEL=/models/defect.onnx
# ROOTCAUSE_NPU_IMGSZ=640
# ROOTCAUSE_NPU_CONF=0.25
# ROOTCAUSE_NPU_TOKEN=replace-me

# Fail readiness (/api/ready) until agent + inference + one live connector are configured.
# ROOTCAUSE_STRICT_INTEGRATIONS=1

# Live plant endpoints (the adapter sets simulate=False when used directly)
# ROOTCAUSE_OPCUA_ENDPOINT=opc.tcp://10.8.4.21:4840
# ROOTCAUSE_MODBUS_ENDPOINT=10.8.4.39:502
# ROOTCAUSE_CAMERA_HTTP_URL=http://10.8.4.51/snapshot.jpg
# ROOTCAUSE_MES_CSV=\\fileshare\\mes\\batches.csv
