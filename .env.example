# RootCause on-site configuration. Copy to .env for a local run.
# The public demo needs none of these.

# Where the SQLite case store and temp uploads live
ROOTCAUSE_RUNTIME=./runtime
# ROOTCAUSE_DB=./runtime/rootcause.sqlite3

# Offline demo pack (generated by scripts/build_demo_pack.py)
# ROOTCAUSE_PACK=./server/rootcause/data/demo_pack.json

# Comma-separated browser origins allowed to call the API
ROOTCAUSE_CORS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Optional Ascend NPU broker. Leave empty to use the CPU detector.
# ROOTCAUSE_NPU=ascend
# ROOTCAUSE_NPU_ENDPOINT=http://127.0.0.1:7788
# ROOTCAUSE_NPU_MODEL=defect.om

# Optional tenant list (each is a separate SQLite file, selected by X-RootCause-Tenant)
# ROOTCAUSE_TENANTS=werk-sued,werk-east

# Optional in-process proactive scheduler (a systemd timer or orchestrator can call /api/proactive/scan instead)
# ROOTCAUSE_SCHEDULER=1
